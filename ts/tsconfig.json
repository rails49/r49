{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,
    "preserveSymlinks": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/r49.json", "tests/**/*.ts"]
}
