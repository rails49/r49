{
  "name": "@rails49/r49-validate",
  "version": "0.1.0",
  "description": "The corpus validator: format rules, corpus rules and warnings for submitted .r49 archives",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "r49-validate": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "validate": "node dist/cli.js",
    "guidance": "node dist/cli.js guidance",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rails49/r49": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "jszip": "^3.10.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.0"
  }
}
